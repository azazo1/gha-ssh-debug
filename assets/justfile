# 临时 SSH 调试食谱, 属于 gha-ssh-debug skill.
#
# 调用形态:
#   just -f <本 skill 目录>/assets/justfile -d <目标 repo 主工作树根目录> branch=<harness>/ssh-debug <recipe> [参数]
#
#   -f  指定本文件, 这样目标 repo 里不必多出任何本 skill 的文件.
#   -d  把 recipe 的工作目录钉在目标 repo 根目录 (just 默认会切到 justfile 所在目录, 必须用 -d 纠回来).
#       要指主工作树, 不是 .tmp 下的 worktree.
#   branch  本次调试用的临时分支名, 由调用者自己定. 别用固定的名字: 不同 harness 用不同前缀
#           (例如 dsh/ssh-debug, claude/ssh-debug), 同一个 repo 被两个 harness 同时调试时才不会撞车.
#           也可以用环境变量 SSH_DEBUG_BRANCH 传.
#
# 这些 recipe 要写目标 repo 的 .git 并访问 gh 凭据, 所以调用时要提权
# (调用参数上就是 sandbox_permissions: danger-full-access 加 approved: true).
# 在 dsh-approve-prefix 里放行 `just -f <本 skill 目录>/assets/justfile` 即可自动通过, 适合无人值守执行.
#
# 实现全在 assets/scripts/*.mjs 里 (node 脚本), 这里只负责派发. 这样做的原因:
#   - recipe 体是一行普通命令行, 不是 shebang 脚本, 于是 Unix 走 sh, Windows 走 cmd, 都不依赖 bash.
#   - just 的 shebang recipe 在 Windows 上不被支持 (just 手册: 会把它拆成命令再调用), 用 bash 写就锁死在 Unix.
# 命令里的引号用 quote() 交给 just 处理, 路径带空格也不会裂开.

skill_dir := justfile_directory()
branch := env("SSH_DEBUG_BRANCH", "")
# 喂完命令后等多久再断连接. 打完就断的话新命令可能根本没执行.
hold_ms := env("SSH_DEBUG_HOLD_MS", "12000")

# 列出所有 recipe.
[private]
default:
    @just --list

# just -f <本 skill 目录>/assets/justfile -d <目标 repo> check
# 只读体检: 目标仓库, 依赖状态, 上次残留, 以及建议配置的 allow prefix.
check:
    @node {{ quote(skill_dir / "scripts/check.mjs") }} --skill-dir={{ quote(skill_dir) }}

# just -f <本 skill 目录>/assets/justfile -d <目标 repo> branch=<branch> prep <runner-label> [ref] [timeout-minutes]
# 开临时 worktree, 按参数生成 workflow, 提交并推送临时分支. 幂等, 重复执行就是重新生成再推一次.
prep runner ref="HEAD" timeout="30":
    @node {{ quote(skill_dir / "scripts/prep.mjs") }} --skill-dir={{ quote(skill_dir) }} --branch={{ quote(branch) }} -- {{ quote(runner) }} {{ quote(ref) }} {{ quote(timeout) }}

# just -f <本 skill 目录>/assets/justfile -d <目标 repo> branch=<branch> status [run-id]
# 不带 run-id 就列该分支最近的 run; 带 run-id 就打印状态, 各步骤结论与 artifact 列表.
status run_id="":
    @node {{ quote(skill_dir / "scripts/status.mjs") }} --skill-dir={{ quote(skill_dir) }} --branch={{ quote(branch) }} -- {{ quote(run_id) }}

# just -f <本 skill 目录>/assets/justfile -d <目标 repo> branch=<branch> connection [run-id] [等待秒数]
# 等会话就绪 (默认最多等 300 秒), 下载 artifact 到临时目录并打印连接命令.
connection run_id="" wait="":
    @node {{ quote(skill_dir / "scripts/connection.mjs") }} --skill-dir={{ quote(skill_dir) }} --branch={{ quote(branch) }} -- {{ quote(run_id) }} {{ quote(wait) }}

# just -f <本 skill 目录>/assets/justfile -d <目标 repo> branch=<branch> ssh [run-id]
# 交互式连进 runner. 人类终端用; agent 用 exec, 不走这条.
ssh run_id="":
    @node {{ quote(skill_dir / "scripts/ssh.mjs") }} --skill-dir={{ quote(skill_dir) }} --branch={{ quote(branch) }} -- {{ quote(run_id) }}

# just -f <本 skill 目录>/assets/justfile -d <目标 repo> branch=<branch> exec <本地脚本> [run-id]
# 把脚本喂进会话并取回这段输出 (agent 在会话里干活走这条, 不要在 shell 里手工拼管道).
exec script_path run_id="":
    @node {{ quote(skill_dir / "scripts/exec.mjs") }} --skill-dir={{ quote(skill_dir) }} --branch={{ quote(branch) }} {{ quote("--hold-ms=" + hold_ms) }} -- {{ quote(script_path) }} {{ quote(run_id) }}

# just -f <本 skill 目录>/assets/justfile -d <目标 repo> branch=<branch> run <本地脚本> [run-id] [timeout-seconds] [轮询间隔秒]
# 把脚本推到 runner 后台跑, 内建轮询, 结束时给出退出码与新增日志 (长任务/复现构建走这条).
run script_path run_id="" timeout="3600" interval="15":
    @node {{ quote(skill_dir / "scripts/run.mjs") }} --skill-dir={{ quote(skill_dir) }} --branch={{ quote(branch) }} -- {{ quote(script_path) }} {{ quote(run_id) }} {{ quote(timeout) }} {{ quote(interval) }}

# just -f <本 skill 目录>/assets/justfile -d <目标 repo> branch=<branch> pull <runner 上的路径> [本地目录] [run-id]
# 会话还活着时从 runner 上 scp 拉取文件或目录; 不给本地目录就落在 <临时目录>/pull/ 下.
pull remote local_dir="" run_id="":
    @node {{ quote(skill_dir / "scripts/pull.mjs") }} --skill-dir={{ quote(skill_dir) }} --branch={{ quote(branch) }} -- {{ quote(remote) }} {{ quote(local_dir) }} {{ quote(run_id) }}

# just -f <本 skill 目录>/assets/justfile -d <目标 repo> branch=<branch> push <本地路径> <runner 上的路径> [run-id]
# 会话还活着时把本地文件送进 runner, 供 CI 复现使用.
push local_path remote run_id="":
    @node {{ quote(skill_dir / "scripts/push.mjs") }} --skill-dir={{ quote(skill_dir) }} --branch={{ quote(branch) }} -- {{ quote(local_path) }} {{ quote(remote) }} {{ quote(run_id) }}

# just -f <本 skill 目录>/assets/justfile -d <目标 repo> branch=<branch> done [run-id]
# 收工: 先放收工标记, 再退出会话, 让 run 收尾成 success.
done run_id="":
    @node {{ quote(skill_dir / "scripts/done.mjs") }} --skill-dir={{ quote(skill_dir) }} --branch={{ quote(branch) }} -- {{ quote(run_id) }}

# just -f <本 skill 目录>/assets/justfile -d <目标 repo> branch=<branch> cancel [run-id]
# 取消 run; 不给 run-id 就取消该分支最近一次.
cancel run_id="":
    @node {{ quote(skill_dir / "scripts/cancel.mjs") }} --skill-dir={{ quote(skill_dir) }} --branch={{ quote(branch) }} -- {{ quote(run_id) }}

# just -f <本 skill 目录>/assets/justfile -d <目标 repo> branch=<branch> clean
# 收工清理: 取消还在跑的 run, 删远程临时分支, 移除 worktree, 删本地分支与临时目录.
clean:
    @node {{ quote(skill_dir / "scripts/clean.mjs") }} --skill-dir={{ quote(skill_dir) }} --branch={{ quote(branch) }}
